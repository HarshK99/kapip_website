# Hostinger FTP credentials for `npm run deploy`.
# Copy this file to `.env` (git-ignored) and fill in real values.
# Source: hPanel → Files → FTP Accounts.
#
# IMPORTANT: deploy.js syncs in 'sync' mode — it DELETES remote files that
# aren't in the local `out/`. So the FTP account MUST be scoped to the site's
# web root: in hPanel → Files → FTP Accounts → Create FTP Account, set the
# Directory to the site's public_html (e.g. /domains/kapip.in/public_html).
# Do NOT use the main account whose root is the home dir — a sync would try to
# delete public_html, domains, mail, etc.

# Server host — the IP or hostname shown in hPanel, NOT the website domain.
FTP_HOST=

# FTP account username (often looks like u123456789.kapip or similar).
FTP_USER=

# FTP account password.
FTP_PASSWORD=

# Hostinger requires explicit FTPS.
FTP_SECURE=true

# Optional overrides:
# FTP_PORT=21
# Prompt before uploading more than this many MB (default 20).
# DEPLOY_CONFIRM_THRESHOLD_MB=20
