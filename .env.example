# Hostinger FTP credentials for `npm run deploy`.
# Copy this file to `.env` (git-ignored) and fill in real values.
# Source: hPanel → Files → FTP Accounts.

# Server host — the IP or hostname shown in hPanel, NOT the website domain.
FTP_HOST=

# FTP account username (often looks like u123456789.kapip or similar).
FTP_USER=

# FTP account password.
FTP_PASSWORD=

# Hostinger requires explicit FTPS.
FTP_SECURE=true

# Optional overrides:
# FTP_PORT=21
# Prompt before uploading more than this many MB (default 20).
# DEPLOY_CONFIRM_THRESHOLD_MB=20
